# Корневой .htaccess MusicStream
Options -Indexes

# Не показывать служебные файлы
<FilesMatch "^(\.git|\.gitignore|\.gitkeep|README\.md)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
